{
  "expo": {
    "name": "뭉글",
    "slug": "moongeul",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moongeul",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.moongeul.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "deploymentTarget": "15.1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "프로필 사진 촬영을 위해 카메라 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "사용자의 기기에 저장된 사진을 프로필 이미지로 등록하거나 게시글에 첨부하기 위해 갤러리 접근 권한이 필요합니다.",
        "NSPhotoLibraryAddUsageDescription": "앱에서 촬영한 사진을 사용자의 갤러리에 저장하기 위해 권한이 필요합니다.",
        "NSUserTrackingUsageDescription": "앱 성능 개선 및 사용자 맞춤형 서비스 제공을 위해 활동 데이터를 수집하고 분석합니다.",
        "NSMicrophoneUsageDescription": "동영상 촬영 시 음성 녹음을 위해 마이크 권한이 필요합니다."
      }
    },
    "android": {
      "package": "com.moongeul.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#272725"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "newArchEnabled": true
          },
          "ios": {
            "deploymentTarget": "15.1",
            "newArchEnabled": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#326BFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "사용자가 선택한 사진을 앱 내에서 활용하기 위해 갤러리에 접근합니다.",
          "cameraPermission": "프로필 사진 촬영을 위해 카메라에 접근합니다."
        }
      ],
      "expo-tracking-transparency"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ec582d8b-e6a3-4d9e-83c7-8b539f21c5be"
      }
    }
  }
}
